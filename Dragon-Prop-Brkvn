local function getJoystickFlyDir(camCF, move)
    if move.Magnitude < 0.05 then return nil end
    local lookFlat = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
    local rightFlat = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
    local fwdInput, rightInput = 0, 0
    if lookFlat.Magnitude > 0.001 then fwdInput = move:Dot(lookFlat.Unit) end
    if rightFlat.Magnitude > 0.001 then rightInput = move:Dot(rightFlat.Unit) end
    local dir = (camCF.LookVector * fwdInput) + (camCF.RightVector * rightInput)
    if dir.Magnitude < 0.001 then return nil end
    return dir.Unit
end

