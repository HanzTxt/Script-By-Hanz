---------------------------------------------------
-- ANTI-DELAY NETWORK: latest-wins, 1 invoke / remote
-- Delay lama = antrian InvokeServer numpuk (lock di-clear tiap 0.5s).
-- Sekarang posisi lama dibuang, hanya CFrame terbaru yang dikirim.
---------------------------------------------------

local pending = {}
local sending = {}

local function pushRemote(remote, payload)
	if not remote then return end
	pending[remote] = payload
	if sending[remote] then return end
	sending[remote] = true
	task.spawn(function()
		repeat
			local data = pending[remote]
			pending[remote] = nil
			pcall(function()
				remote:InvokeServer(data)
			end)
		until pending[remote] == nil
		sending[remote] = false
	end)
end

local function flushNetwork()
	table.clear(pending)
end

