-- NETWORK
---------------------------------------------------
local pending = {}
local sending = {}

local function pushRemote(remote, payload)
    if not remote then return end
    pending[remote] = payload
    if sending[remote] then return end
    sending[remote] = true
    task.spawn(function()
        repeat
            local data = pending[remote]
            pending[remote] = nil
            pcall(function()
                remote:InvokeServer(data)
            end)
        until pending[remote] == nil
        sending[remote] = false
    end)
end

local function flushNetwork()
    table.clear(pending)
end

---------------------------------------------------
-- PRECISION HELPERS
---------------------------------------------------
local function clampDirection(dir)
    if dir.Magnitude < 0.001 then
        return Vector3.new(0, 0, 1)
    end
    dir = dir.Unit
    if math.abs(dir.Y) <= MAX_PITCH_Y then
        return dir
    end
    local horiz = Vector3.new(dir.X, 0, dir.Z)
    if horiz.Magnitude < 0.001 then
        horiz = Vector3.new(0, 0, 1)
    end
    horiz = horiz.Unit
    local newY = (dir.Y > 0) and MAX_PITCH_Y or -MAX_PITCH_Y
    local hMag = math.sqrt(1 - newY * newY)
    return (horiz * hMag + Vector3.new(0, newY, 0)).Unit
end

local function stableLookAt(pos, dir)
    local mag = dir.Magnitude
    if mag < 0.001 then
        return CFrame.new(pos)
    end
    dir = dir / mag
    local up = Vector3.new(0, 1, 0)
    if math.abs(dir.Y) > 0.9 then
        up = Vector3.new(1, 0, 0)
    end
    return CFrame.lookAt(pos, pos + dir, up)
end

local function computeHeadBase(pos, rawDir)
    local dir = clampDirection(rawDir)
    local base = stableLookAt(pos, dir)
    return base * CFrame.Angles(0, math.rad(180), 0)
end

local function slerpDir(a, b, t)
    a = a.Unit
    b = b.Unit
    local dot = math.clamp(a:Dot(b), -1, 1)
    if dot > 0.9995 then return b end
    if dot < -0.9995 then
        local axis = a:Cross(Vector3.new(1, 0, 0))
        if axis.Magnitude < 0.001 then axis = a:Cross(Vector3.new(0, 0, 1)) end
        local ang = math.pi * t
        local q = CFrame.fromAxisAngle(axis.Unit, ang)
        return (q * a).Unit
    end
    local theta = math.acos(dot) * t
    local rel = (b - a * dot).Unit
    return (a * math.cos(theta) + rel * math.sin(theta)).Unit
end

