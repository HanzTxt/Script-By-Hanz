-- tombol toggle: LED emas di kiri menyala otomatis kalau teks berisi ": ON"
local function createButton(parent, text, order, accent, noLed)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 36)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextScaled = true
    btn.TextColor3 = THEME.text
    btn.BackgroundColor3 = accent or THEME.idle
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.Parent = parent
    corner(btn, 8)
    stroke(btn, THEME.borderSoft, 1)
    local lim = Instance.new("UITextSizeConstraint", btn)
    lim.MaxTextSize = 12; lim.MinTextSize = 7
    local p = Instance.new("UIPadding", btn)
    p.PaddingLeft = UDim.new(0, noLed and 6 or 16)
    p.PaddingRight = UDim.new(0, 6)
    p.PaddingTop = UDim.new(0, 8)
    p.PaddingBottom = UDim.new(0, 8)
    if not noLed then
        local led = Instance.new("Frame", btn)
        led.AnchorPoint = Vector2.new(0, 0.5)
        led.Position = UDim2.new(0, -12, 0.5, 0) -- dikompensasi padding kiri 16
        led.Size = UDim2.new(0, 3, 0, 16)
        led.BackgroundColor3 = Color3.fromRGB(70,55,60)
        led.BorderSizePixel = 0
        corner(led, 2)
        local function sync()
            local on = string.find(btn.Text, ": ON", 1, true) ~= nil
            TweenService:Create(led, TweenInfo.new(0.2), {
                BackgroundColor3 = on and THEME.accentGold or Color3.fromRGB(70,55,60)
            }):Play()
        end
        btn:GetPropertyChangedSignal("Text"):Connect(sync)
        sync()
    end
    return btn
end

