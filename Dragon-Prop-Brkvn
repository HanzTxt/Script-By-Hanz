    -- drag window (hanya jari yang menekan header; posisi dibatasi supaya header tetap terlihat)
    local dragging = false
    local dragStart, startPos, potentialDrag, dragInput

    header.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            potentialDrag = true
            dragInput = input
            dragStart = input.Position
            startPos = main.Position
        end
    end)

    track(UIS.InputChanged:Connect(function(input)
        if not potentialDrag then return end
        local t = input.UserInputType
        if t == Enum.UserInputType.Touch and input ~= dragInput then return end
        if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if not dragging and delta.Magnitude > 5 then dragging = true end
            if dragging then
                local cam = workspace.CurrentCamera
                local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
                local headY = (420 / 2 - 27) * mainUserScale * fitScale
                local ox = math.clamp(startPos.X.Offset + delta.X, -vp.X / 2 + 80, vp.X / 2 - 80)
                local oy = math.clamp(startPos.Y.Offset + delta.Y, 16 - vp.Y / 2 + headY, vp.Y / 2 - 16 + headY)
                main.Position = UDim2.new(startPos.X.Scale, ox, startPos.Y.Scale, oy)
            end
        end
    end))

    track(UIS.InputEnded:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or (t == Enum.UserInputType.Touch and input == dragInput) then
            potentialDrag = false
            dragging = false
            dragInput = nil
        end
    end))

    local bubbleDragStart, bubbleStartPos, bubbleMoved, bubbleInput = nil, nil, false, nil

    bubbleBtn.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            bubbleInput = input
            bubbleDragStart = input.Position
            bubbleStartPos = bubble.Position
            bubbleMoved = false
        end
    end)

    track(UIS.InputChanged:Connect(function(input)
        if not bubbleDragStart then return end
        local t = input.UserInputType
        if t == Enum.UserInputType.Touch and input ~= bubbleInput then return end
        if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
            local delta = input.Position - bubbleDragStart
            if delta.Magnitude > 4 then bubbleMoved = true end
            if bubbleMoved and camera then
                local vp = camera.ViewportSize
                local cx = bubbleStartPos.X.Scale * vp.X + bubbleStartPos.X.Offset + delta.X
                local cy = bubbleStartPos.Y.Scale * vp.Y + bubbleStartPos.Y.Offset + delta.Y
                cx = math.clamp(cx, 36, math.max(36, vp.X - 36))
                cy = math.clamp(cy, 36, math.max(36, vp.Y - 36))
                bubble.Position = UDim2.fromOffset(cx, cy)
            end
        end
    end))

    track(UIS.InputEnded:Connect(function(input)
        if not bubbleDragStart then return end
        local t = input.UserInputType
        if t == Enum.UserInputType.Touch and input ~= bubbleInput then return end
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            if not bubbleMoved then
                restore()
            else
                if camera then
                    local centerX = bubble.AbsolutePosition.X + bubble.AbsoluteSize.X / 2
                    local vp = camera.ViewportSize
                    local cy = bubble.AbsolutePosition.Y + bubble.AbsoluteSize.Y / 2
                    cy = math.clamp(cy, 36, math.max(36, vp.Y - 36))
                    local targetPos = (centerX < vp.X / 2) and UDim2.fromOffset(52, cy) or UDim2.fromOffset(vp.X - 52, cy)
                    tween(bubble, {Position = targetPos}, 0.25)
                end
            end
            bubbleDragStart = nil
            bubbleInput = nil
        end
    end))

    minBtn.MouseButton1Click:Connect(minimize)
    closeBtn.MouseButton1Click:Connect(shutdown)

    setSpawnType(SpawnAnimType)
    updateModeButtons()

    local loadingSteps = {
        {0.15, "Initializing core systems...", 0.35},
        {0.35, "Loading assets...", 0.4},
        {0.55, "Summoning dragon...", 0.4},
        {0.75, "Applying theme...", 0.35},
        {0.90, "Finalizing interface...", 0.35},
        {1.00, "Ready", 0.25},
    }

    task.spawn(function()
        task.wait(0.3)
        for _, step in ipairs(loadingSteps) do
            if not alive then return end
            -- animasi loading hanya kosmetik; kalau loadingGui hilang, tetap lanjut ke reveal
            if aliveInst(loadingGui) then
                statusLabel.Text = step[2]
                tween(barFill, {Size = UDim2.new(step[1], 0, 1, 0)}, step[3])
                tween(percentValue, {Value = step[1] * 100}, step[3])
            end
            task.wait(step[3])
        end
        if not alive then return end
        task.wait(0.35)
        if not alive or not aliveInst(main) then return end

        if spinConn then spinConn:Disconnect() spinConn = nil end

        recomputeFit()
        main.Visible = true
        animScaleValue.Value = 0
        tween(animScaleValue, {Value = 1}, 0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        if aliveInst(loadingGui) then
            for _, v in ipairs(loading:GetDescendants()) do
                if v:IsA("ImageLabel") then tween(v, {ImageTransparency = 1}, 0.55) end
                if v:IsA("GuiObject") then pcall(function() tween(v, {BackgroundTransparency = 1}, 0.55) end) end
                if v:IsA("TextLabel") then tween(v, {TextTransparency = 1}, 0.55) end
                if v:IsA("UIStroke") then tween(v, {Transparency = 1}, 0.55) end
            end
            tween(loading, {BackgroundTransparency = 1}, 0.55)
        end

        task.delay(0.65, function()
            if loadingGui then loadingGui:Destroy() end
        end)
    end)
end

local okUI, errUI = pcall(buildUI)
if not okUI then
    warn("[DragonSystem] gagal membuat UI: " .. tostring(errUI))
    pcall(function()
        if spinConn then spinConn:Disconnect() spinConn = nil end
        if loadingGui then loadingGui:Destroy() loadingGui = nil end
        local g = Instance.new("ScreenGui")
        g.Name = "DragonSystemError"
        g.ResetOnSpawn = false
        g.IgnoreGuiInset = true
        g.DisplayOrder = 1001
        g.Parent = playerGui
        local box = Instance.new("TextLabel")
        box.Size = UDim2.new(0.9, 0, 0, 130)
        box.Position = UDim2.new(0.5, 0, 0.5, 0)
        box.AnchorPoint = Vector2.new(0.5, 0.5)
        box.BackgroundColor3 = Color3.fromRGB(40, 10, 14)
        box.TextColor3 = Color3.fromRGB(255, 200, 200)
        box.Font = Enum.Font.Code
        box.TextSize = 13
        box.TextWrapped = true
        box.Text = "DRAGON SYSTEM - gagal membuat UI:\n" .. tostring(errUI)
        box.Parent = g
        task.delay(30, function() g:Destroy() end)
    end)
end
