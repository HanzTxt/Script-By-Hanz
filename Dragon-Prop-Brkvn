local pending = {}
local inflight = 0
local netGen = 0
local lastDispatch = 0
local netConn
local SEND_INTERVAL = 1 / 30 -- batas kirim tercepat (detik)
local NET_TIMEOUT = 0.75     -- kalau server lambat, jangan nunggu selamanya

local function pushRemote(remote, payload)
    if remote then
        pending[remote] = payload
    end
end

local function flushNetwork()
    pending = {}
end

local function dispatchBatch()
    local batch = pending
    if next(batch) == nil then return end
    pending = {}
    netGen += 1
    local myGen = netGen
    inflight = 0
    lastDispatch = os.clock()
    for remote, data in pairs(batch) do
        inflight += 1
        task.spawn(function()
            pcall(function()
                remote:InvokeServer(data)
            end)
            if myGen == netGen then
                inflight -= 1
            end
        end)
    end
end

netConn = RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if now - lastDispatch < SEND_INTERVAL then return end
    if inflight > 0 and now - lastDispatch < NET_TIMEOUT then return end
    dispatchBatch()
end)

---------------------------------------------------
-- PRECISION HELPERS
---------------------------------------------------
-- smoothing yang tidak tergantung FPS (k = faktor per frame @60fps)
local function alphaDt(k, dt)
    return 1 - (1 - k) ^ (dt * 60)
end

local function clampDirection(dir)
    if dir.Magnitude < 0.001 then
        return Vector3.new(0, 0, 1)
    end
    dir = dir.Unit
    if math.abs(dir.Y) <= MAX_PITCH_Y then
        return dir
    end
    local horiz = Vector3.new(dir.X, 0, dir.Z)
    if horiz.Magnitude < 0.001 then
        horiz = Vector3.new(0, 0, 1)
    end
    horiz = horiz.Unit
    local newY = (dir.Y > 0) and MAX_PITCH_Y or -MAX_PITCH_Y
    local hMag = math.sqrt(1 - newY * newY)
    return (horiz * hMag + Vector3.new(0, newY, 0)).Unit
end

local function slerpDir(a, b, t)
    a = a.Unit
    b = b.Unit
    local dot = math.clamp(a:Dot(b), -1, 1)
    if dot > 0.9995 then return b end
    if dot < -0.9995 then
        local axis = a:Cross(Vector3.new(1, 0, 0))
        if axis.Magnitude < 0.001 then axis = a:Cross(Vector3.new(0, 0, 1)) end
        local ang = math.pi * t
        local q = CFrame.fromAxisAngle(axis.Unit, ang)
        return (q * a).Unit
    end
    local theta = math.acos(dot) * t
    local rel = (b - a * dot).Unit
    return (a * math.cos(theta) + rel * math.sin(theta)).Unit
end

-- proyeksikan "atas" ke bidang tegak lurus arah (selalu valid, tidak pernah flip)
local function projectUp(up, dir, fallback)
    local u = up - dir * up:Dot(dir)
    if u.Magnitude < 1e-3 and fallback then
        u = fallback - dir * fallback:Dot(dir)
    end
    if u.Magnitude < 1e-3 then
        u = WORLD_UP - dir * dir.Y
        if u.Magnitude < 1e-3 then
            u = Vector3.new(1, 0, 0) - dir * dir.X
        end
    end
    return u.Unit
end

-- CFrame dari posisi + arah hadap (look) + atas (up). -Z = look, seperti CFrame.lookAt
local function makeFrame(pos, look, up)
    local right = look:Cross(up)
    if right.Magnitude < 1e-4 then
        right = look:Cross(projectUp(up, look))
    end
    right = right.Unit
    local trueUp = right:Cross(look)
    return CFrame.fromMatrix(pos, right, trueUp, -look)
end

local function updateHeadUp(dt)
    local d = smoothHeadDir
    local u = projectUp(HeadUp, d)
    -- tarik pelan ke "atas dunia" supaya tidak miring terus; makin tegak makin lemah
    local wu = WORLD_UP - d * d.Y
    local w = wu.Magnitude
    if w > 0.05 then
        local pull = alphaDt(0.1 * math.min(w, 1), dt)
        u = projectUp(slerpDir(u, wu.Unit, pull), d, u)
    end
    HeadUp = u
end

local function segGap(i)
    return (i == 2) and (TAIL_SEGMENT_DISTANCE + 2) or TAIL_SEGMENT_DISTANCE
end

-- badan dibentangkan lurus di belakang kepala (tidak numpuk di 1 titik)
local function layStraight(pos, dir)
    table.clear(Seg)
    table.clear(BodyUp)
    Seg[1] = pos
    for i = 2, #Props + 1 do
        Seg[i] = Seg[i - 1] - dir * segGap(i)
    end
end

