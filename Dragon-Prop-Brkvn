-- JOYSTICK / WASD → ARAH TERBANG 3D
---------------------------------------------------
local function getJoystickFlyDir(camCF, move)
    if move.Magnitude < 0.05 then
        return nil
    end
    local lookFlat = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
    local rightFlat = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
    local fwdInput = 0
    local rightInput = 0
    if lookFlat.Magnitude > 0.001 then
        fwdInput = move:Dot(lookFlat.Unit)
    end
    if rightFlat.Magnitude > 0.001 then
        rightInput = move:Dot(rightFlat.Unit)
    end
    local dir = (camCF.LookVector * fwdInput) + (camCF.RightVector * rightInput)
    if dir.Magnitude < 0.001 then
        return nil
    end
    return dir.Unit
end

---------------------------------------------------
-- MAIN RENDER LOOP
---------------------------------------------------
RunService:BindToRenderStep("DragonControlSystem", 199, function(dt)
    if not Enabled then return end

    if tick() - lastUpdate > updateDelay then
        updateProps()
        lastUpdate = tick()
    end

    if #Props == 0 and #headDead == 0 then return end

    if StopMovementEnabled and not spawnAnimActive then
        return
    end

    local camCF = camera.CFrame

    -- ANIMASI SPAWN
    if spawnAnimActive then
        local t = math.clamp((tick() - spawnAnimStart) / SpawnAnimDuration, 0, 1)
        local ease = 1 - (1 - t) ^ 3
        local pos = spawnAnimStartPos:Lerp(spawnAnimEndPos, ease)

        if SpawnAnimType == 2 then
            spawnAnimSpiralAngle = spawnAnimSpiralAngle + dt * 3
            local spiralRadius = 8 * math.sin(t * math.pi)
            pos = pos + Vector3.new(
                math.cos(spawnAnimSpiralAngle) * spiralRadius,
                0,
                math.sin(spawnAnimSpiralAngle) * spiralRadius
            )
        end

        local turnT = math.clamp((t - 0.55) / 0.45, 0, 1)
        local turnEase = turnT * turnT * (3 - 2 * turnT)
        local targetDir = slerpDir(spawnAnimStartDir, spawnAnimEndDir, turnEase)

        dragonPos = pos
        smoothHeadDir = targetDir
        HeadDir = targetDir
        Seg[1] = pos

        if t >= 1 then
            spawnAnimActive = false
            dragonPos = spawnAnimEndPos
            smoothHeadDir = spawnAnimEndDir
            HeadDir = spawnAnimEndDir
        end

    else
        if FollowPlayerEnabled and hrp then
            HeadDir = hrp.CFrame.LookVector
            local targetPos = (hrp.CFrame * CFrame.new(0, 10, 3)).Position
            dragonPos = dragonPos:Lerp(targetPos, 0.2)
        else
            local move = humanoid and humanoid.MoveDirection or Vector3.zero
            local flyDir = getJoystickFlyDir(camCF, move)
            if flyDir then
                HeadDir = flyDir
                dragonPos += flyDir * baseSpeed * math.min(move.Magnitude, 1)
            end
        end

        smoothHeadDir = smoothHeadDir:Lerp(HeadDir, headTurnSpeed)
        if smoothHeadDir.Magnitude > 0.001 then
            smoothHeadDir = smoothHeadDir.Unit
        end
        Seg[1] = Seg[1] and Seg[1]:Lerp(dragonPos, 0.35) or dragonPos
    end

    -- TAIL: clamp cur ke prev dulu agar selalu valid → tidak ada prop yang snap/terpisah
    local totalSegments = #Props + 1
    for i = 2, totalSegments do
        local prev = Seg[i - 1]
        local cur = Seg[i] or prev
        local currentDistance = (i == 2) and (TAIL_SEGMENT_DISTANCE + 2) or TAIL_SEGMENT_DISTANCE

        -- CLAMP cur agar selalu dekat prev (cegah kepisah saat naga lari cepat)
        local curDelta = prev - cur
        if curDelta.Magnitude > currentDistance then
            cur = prev - (curDelta.Unit * currentDistance)
        end

        local d
        if i == 2 then
            d = smoothHeadDir
        else
            d = (prev - cur)
            d = (d.Magnitude > 0.001) and d.Unit or smoothHeadDir
        end

        local target = prev - (d * currentDistance)
        local newPos = cur:Lerp(target, tailSmoothness)

        -- Pastikan tidak melebihi jarak max
        local constraintDelta = prev - newPos
        if constraintDelta.Magnitude > currentDistance then
            newPos = prev - (constraintDelta.Unit * currentDistance)
        end

        Seg[i] = newPos
    end

    local headBase = computeHeadBase(Seg[1], smoothHeadDir)

    local jawCF = AttackEnabled
        and (headBase * CFrame.new(0, -2.5, -0.5) * CFrame.Angles(math.rad(115), 0, 0))
        or (headBase * CFrame.new(0, -2.5, 0) * CFrame.Angles(math.rad(90), 0, 0))

    local cfa1 = headBase * CFrame.new(0, 2.5, -2.5) * CFrame.Angles(math.rad(100), 0, 0)
    local cfa2 = headBase * CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(90), 0, 0)
    local cfa3 = headBase * CFrame.new(0, -4.5, -1.15)

    if headDead[1] then pushRemote(headDead[1], cfa1) end
    if headDead[2] then pushRemote(headDead[2], cfa2) end
    if headDead[3] then pushRemote(headDead[3], cfa3) end
    if headDead[4] then pushRemote(headDead[4], jawCF) end

    if headEgg[1] then pushRemote(headEgg[1], cfa2 * CFrame.new(1.2, 1.2, -1.2)) end
    if headEgg[2] then pushRemote(headEgg[2], cfa2 * CFrame.new(-1.4, 1.2, -1.2)) end

    if headTube[1] then
        pushRemote(headTube[1], cfa2 * CFrame.new(-1, -1.5, -3) * CFrame.Angles(math.rad(210), 0, math.rad(30)))
    end
    if headTube[2] then
        pushRemote(headTube[2], cfa2 * CFrame.new(1, -1.5, -3) * CFrame.Angles(math.rad(210), 0, math.rad(-30)))
    end

    for _, seatRemote in ipairs(headSeat) do
        pushRemote(seatRemote, cfa2 * SEAT_OFFSET)
    end

    -----------------------------------------------------------
    -- LASER: hadap DEPAN kepala (bukan belakang)
    -- headBase punya rotasi 180°Y → forward -Z = -lookDir (belakang)
    -- Tambah Angles(0, 180°, 0) SETELAH LASER_OFFSET → balik ke hadap depan
    -- Posisi tetap di mulut, tidak berubah karena LASER_OFFSET translasi only
    -- Drill spin Y lokal setelah LASER_PART_FIX (poros hadap)
    -----------------------------------------------------------
    if AttackEnabled then
        fireWasHidden = false

        laserSpinAngle = (laserSpinAngle + dt * math.rad(LASER_SPIN_SPEED)) % (math.pi * 2)

        local baseFrame = headBase * LASER_OFFSET * CFrame.Angles(math.rad(20), math.rad(180), 0) * LASER_PART_FIX

        local count = math.max(#fireProps, 1)
        for i, fireRemote in ipairs(fireProps) do
            local phase = (i - 1) * (math.pi * 2 / count)
            local totalY = laserSpinAngle + phase
            local finalCF = baseFrame * CFrame.Angles(0, totalY, 0)
            pushRemote(fireRemote, finalCF)
        end
    elseif not fireWasHidden then
        fireWasHidden = true
        laserSpinAngle = 0
        local hiddenCF = CFrame.new(0, -40, 0)
        for _, fireRemote in ipairs(fireProps) do
            pushRemote(fireRemote, hiddenCF)
        end
    end

    for i, v in ipairs(Props) do
        local pos = Seg[i + 1]
        local nextPos = Seg[i] or pos
        if pos then
            local dir = (nextPos - pos)
            if dir.Magnitude > 0.001 then
                dir = dir.Unit
                pushRemote(v, stableLookAt(pos, dir) * CFrame.Angles(math.rad(-90), 0, 0))
                if moonProps[i] then
                    pushRemote(
                        moonProps[i],
                        stableLookAt(pos + Vector3.new(0, 1, 0), dir)
                            * CFrame.Angles(math.rad(30), math.rad(-90), 0)
                            * CFrame.new(-3, -2, 0)
                    )
                end
            end
        end
    end

    if tailCone[1] and #Seg > 1 and Seg[#Seg] then
        local pos = Seg[#Seg]
        local lastSegmentDir = (Seg[#Seg] - Seg[#Seg - 1])
        if lastSegmentDir.Magnitude > 0.001 then
            pushRemote(tailCone[1], stableLookAt(pos, lastSegmentDir.Unit) * CFrame.Angles(math.rad(-90), 0, 0))
        end
    end

    if TeleportEnabled and hrp then
        local head = Seg[1] or dragonPos
        local dir = clampDirection(smoothHeadDir)
        hrp.CFrame = CFrame.lookAt(head + Vector3.new(0, 3, 0), head + (dir * 10))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if CamEnabled and camPart then
        local head = Seg[1] or dragonPos
        local dir = clampDirection(smoothHeadDir)
        camPart.CFrame = CFrame.lookAt(head + Vector3.new(0, 2.5, 0), head + Vector3.new(0, 2.5, 0) + dir)
        if camera.CameraSubject ~= camPart then
            applyDragonCam()
        end
    end
end)

