local function aliveInst(inst)
    if typeof(inst) ~= "Instance" then return false end
    local ok, parent = pcall(function() return inst.Parent end)
    return ok and parent ~= nil
end

local function pointerX(input)
    if input and input.UserInputType == Enum.UserInputType.Touch then
        return input.Position.X
    end
    return UIS:GetMouseLocation().X
end

-- onEnd(n) dipanggil saat jari/mouse dilepas (n = nilai terakhir 0..1)
local function bindHSlider(bar, scrollPage, applyN, extraHits, onEnd)
    local dragging = false
    local activeInput = nil
    local originX, width = 0, 0
    local lastN = 0

    local function fromInput(input)
        if width <= 0 then return end
        lastN = math.clamp((pointerX(input) - originX) / width, 0, 1)
        applyN(lastN)
    end

    local function onBegin(input)
        local t = input.UserInputType
        if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        activeInput = input
        originX = bar.AbsolutePosition.X
        width = math.max(bar.AbsoluteSize.X, 1)
        if scrollPage then scrollPage.ScrollingEnabled = false end
        fromInput(input)
    end

    bar.InputBegan:Connect(onBegin)
    for _, hit in ipairs(extraHits or {}) do
        hit.Active = true
        hit.InputBegan:Connect(onBegin)
    end

    track(UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        local t = input.UserInputType
        if t == Enum.UserInputType.Touch then
            if input ~= activeInput then return end
        elseif t ~= Enum.UserInputType.MouseMovement then
            return
        end
        fromInput(input)
    end))

    track(UIS.InputEnded:Connect(function(input)
        if not dragging then return end
        local t = input.UserInputType
        local isEnd = (t == Enum.UserInputType.MouseButton1)
            or (t == Enum.UserInputType.Touch and input == activeInput)
        if not isEnd then return end
        dragging = false
        activeInput = nil
        if scrollPage then scrollPage.ScrollingEnabled = true end
        if onEnd then onEnd(lastN) end
    end))
end

