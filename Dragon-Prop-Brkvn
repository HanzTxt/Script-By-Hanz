            Size = UDim2.new(0.5, 0, 1, 0),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
            Text = labelText, TextSize = 13, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
        })

        local box = make("TextBox", {
            Size = UDim2.new(0.35, 0, 0, 26),
            Position = UDim2.new(1, -14, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundColor3 = Theme.BG3, Font = Enum.Font.GothamBold,
            Text = tostring(defaultValue), TextSize = 12,
            TextColor3 = Theme.Gold, ClearTextOnFocus = false,
            BorderSizePixel = 0, Parent = row,
        })
        corner(box, 6)
        addStroke(box, Theme.Stroke, 1, 0)

        local lastGood = tostring(defaultValue)
        box.FocusLost:Connect(function()
            local num = tonumber(box.Text)
            if not num or num ~= num or num == math.huge or num == -math.huge then
                box.Text = lastGood
                return
            end
            local shown = onChanged(num)
            if type(shown) ~= "number" then shown = num end
            lastGood = tostring(shown)
            box.Text = lastGood
        end)
        return row, box
    end

