-- STRUCTURAL PROP ACQUISITION
-- Urutan prop DIJAGA tetap (prop lama tidak dipindah-pindah),
-- jadi segmen badan tidak tertukar tiap re-scan.
---------------------------------------------------
local function updateProps()
    local folder = workspace:FindFirstChild("WorkspaceCom")
    if not folder then return end
    local cone = folder:FindFirstChild("001_TrafficCones")
    if not cone then return end

    local pname = player.Name
    local propName = "Prop" .. pname
    local found = {}
    local changed = false

    for _, v in ipairs(cone:GetChildren()) do
        local n = v.Name
        if n == propName or string.find(n, pname, 1, true) then
            local remote = v:FindFirstChild("SetCurrentCFrame")
            local id = v:GetAttribute("id")
            local category = id and CAT_BY_ID[id]
            if remote and category then
                found[remote] = true
                if not knownProp[remote] then
                    knownProp[remote] = category
                    table.insert(Cat[category], remote)
                    colorOf[remote] = v:FindFirstChild("ChangePropColor")
                    changed = true
                end
            end
        end
    end

    for remote, category in pairs(knownProp) do
        if not found[remote] then
            knownProp[remote] = nil
            colorOf[remote] = nil
            local list = Cat[category]
            local idx = table.find(list, remote)
            if idx then table.remove(list, idx) end
            changed = true
        end
    end

    if changed then
        colorDirty = true
    end
end

