local function updateProps()
	table.clear(Props)
	table.clear(headDead)
	table.clear(headTube)
	table.clear(headEgg)
	table.clear(moonProps)
	table.clear(tailCone)
	table.clear(fireProps)
	table.clear(ColorRemotes)

	local folder = workspace:FindFirstChild("WorkspaceCom")
	if not folder then return end

	local cone = folder:FindFirstChild("001_TrafficCones")
	if not cone then return end

	local pname = player.Name
	local propName = "Prop" .. pname

	for _, v in ipairs(cone:GetChildren()) do
		local n = v.Name
		if n == propName or string.find(n, pname, 1, true) then
			local remote = v:FindFirstChild("SetCurrentCFrame")
			local id = v:GetAttribute("id")
			if remote and id then
				if id == "DeadGraveBlood" then
					table.insert(headDead, remote)
					local colorRemote = v:FindFirstChild("ChangePropColor")
					if colorRemote then table.insert(ColorRemotes, colorRemote) end
				elseif id == "TubeLamp" then
					table.insert(headTube, remote)
				elseif id == "EggLamp" then
					table.insert(headEgg, remote)
				elseif id == "Cylinder" then
					table.insert(Props, remote)
					local colorRemote = v:FindFirstChild("ChangePropColor")
					if colorRemote then table.insert(ColorRemotes, colorRemote) end
				elseif id == "GirlyShapeMoon" then
					table.insert(moonProps, remote)
				elseif id == "Cone" then
					table.insert(tailCone, remote)
				elseif id == "LightsSpotLightRed" then
					table.insert(fireProps, remote)
				end
			end
		end
	end
end

