task.spawn(function()
	local colors = { Color3.fromRGB(120, 0, 0), Color3.fromRGB(0, 0, 0) }
	local colorIndex = 1

	while true do
		if LoopColorEnabled and Enabled and #ColorRemotes > 0 then
			local targetColor = colors[colorIndex]
			for _, colorRem in ipairs(ColorRemotes) do
				pushRemote(colorRem, targetColor)
			end
			colorIndex = colorIndex == 1 and 2 or 1
		end
		task.wait(0.5)
	end
end)

