local function pushRemote(remote, payload)
    if remote then pending[remote] = payload end
end
local function flushNetwork() pending = {} end

local function dispatchBatch()
    local batch = pending
    if next(batch) == nil then return end
    pending = {}
    netGen += 1
    local myGen = netGen
    inflight = 0
    lastDispatch = os.clock()
    for remote, data in pairs(batch) do
        inflight += 1
        task.spawn(function()
            pcall(function() remote:InvokeServer(data) end)
            if myGen == netGen then inflight -= 1 end
        end)
    end
end

netConn = RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if now - lastDispatch < SEND_INTERVAL then return end
    if inflight > 0 and now - lastDispatch < NET_TIMEOUT then return end
    dispatchBatch()
end)

local function alphaDt(k, dt) return 1 - (1 - k) ^ (dt * 60) end

local function clampDirection(dir)
    if dir.Magnitude < 0.001 then return Vector3.new(0, 0, 1) end
    dir = dir.Unit
    if math.abs(dir.Y) <= MAX_PITCH_Y then return dir end
    local horiz = Vector3.new(dir.X, 0, dir.Z)
    if horiz.Magnitude < 0.001 then horiz = Vector3.new(0, 0, 1) end
    horiz = horiz.Unit
    local newY = (dir.Y > 0) and MAX_PITCH_Y or -MAX_PITCH_Y
    local hMag = math.sqrt(1 - newY * newY)
    return (horiz * hMag + Vector3.new(0, newY, 0)).Unit
end

local function slerpDir(a, b, t)
    if not a or a.Magnitude < 1e-4 then a = Vector3.new(0, 0, 1) else a = a.Unit end
    if not b or b.Magnitude < 1e-4 then b = Vector3.new(0, 0, 1) else b = b.Unit end
    local dot = math.clamp(a:Dot(b), -1, 1)
    if dot > 0.9995 then return b end
    if dot < -0.9995 then
        local axis = a:Cross(Vector3.new(1, 0, 0))
        if axis.Magnitude < 0.001 then axis = a:Cross(Vector3.new(0, 0, 1)) end
        if axis.Magnitude < 1e-4 then return b end
        return (CFrame.fromAxisAngle(axis.Unit, math.pi * t) * a).Unit
    end
    local theta = math.acos(dot) * t
    local rel = b - a * dot
    if rel.Magnitude < 1e-4 then return b end
    rel = rel.Unit
    return (a * math.cos(theta) + rel * math.sin(theta)).Unit
end

local function projectUp(up, dir, fallback)
    local u = up - dir * up:Dot(dir)
    if u.Magnitude < 1e-3 and fallback then u = fallback - dir * fallback:Dot(dir) end
    if u.Magnitude < 1e-3 then
        u = WORLD_UP - dir * dir.Y
        if u.Magnitude < 1e-3 then u = Vector3.new(1, 0, 0) - dir * dir.X end
    end
    return u.Unit
end

local function makeFrame(pos, look, up)
    if not look or look.Magnitude < 1e-4 then look = Vector3.new(0, 0, 1) else look = look.Unit end
    if not up or up.Magnitude < 1e-4 then up = WORLD_UP end
    local right = look:Cross(up)
    if right.Magnitude < 1e-4 then right = look:Cross(projectUp(up, look)) end
    if right.Magnitude < 1e-4 then right = look:Cross(WORLD_UP) end
    if right.Magnitude < 1e-4 then right = look:Cross(Vector3.new(1, 0, 0)) end
    if right.Magnitude < 1e-4 then return CFrame.new(pos) end
    right = right.Unit
    local trueUp = right:Cross(look)
    if trueUp.Magnitude < 1e-4 then return CFrame.new(pos) end
    return CFrame.fromMatrix(pos, right, trueUp.Unit, -look)
end

local function updateHeadUp(dt)
    local d = smoothHeadDir
    local u = projectUp(HeadUp, d)
    local wu = WORLD_UP - d * d.Y
    local w = wu.Magnitude
    if w > 0.05 then
        local pull = alphaDt(0.1 * math.min(w, 1), dt)
        u = projectUp(slerpDir(u, wu.Unit, pull), d, u)
    end
    HeadUp = u
end

local function segGap(i) return (i == 2) and (TAIL_SEGMENT_DISTANCE + 2) or TAIL_SEGMENT_DISTANCE end

local function layStraight(pos, dir)
    table.clear(Seg); table.clear(BodyUp)
    Seg[1] = pos
    for i = 2, #Props + 1 do Seg[i] = Seg[i - 1] - dir * segGap(i) end
end

local function updateProps()
    local folder = workspace:FindFirstChild("WorkspaceCom")
    if not folder then return end
    local cone = folder:FindFirstChild("001_TrafficCones")
    if not cone then return end
    local pname = player.Name
    local propName = "Prop" .. pname
    local found = {}
    local changed = false

    for _, v in ipairs(cone:GetChildren()) do
        local n = v.Name
        if n == propName or string.find(n, pname, 1, true) then
            local remote = v:FindFirstChild("SetCurrentCFrame")
            local id = v:GetAttribute("id")
            local category = id and CAT_BY_ID[id]
            if remote and category then
                found[remote] = true
                if not knownProp[remote] then
                    knownProp[remote] = category
                    table.insert(Cat[category], remote)
                    colorOf[remote] = v:FindFirstChild("ChangePropColor")
                    changed = true
                end
            end
        end
    end

    for remote, category in pairs(knownProp) do
        if not found[remote] then
            knownProp[remote] = nil
            colorOf[remote] = nil
            local list = Cat[category]
            local idx = table.find(list, remote)
            if idx then table.remove(list, idx) end
            changed = true
        end
    end

    if changed then colorDirty = true end
end

local function beginSpawnAnimation()
    if not hrp then return end
    updateProps()
    lastUpdate = os.clock()

    local look = hrp.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.001 then flat = Vector3.new(0, 0, 1) end
    flat = flat.Unit

    spawnAnimEndPos = hrp.Position + Vector3.new(0, 8, 0)
    spawnAnimEndDir = flat

    if not SpawnAnimEnabled then
        dragonPos = spawnAnimEndPos
        smoothHeadDir = flat
        HeadDir = flat
        HeadUp = WORLD_UP
        layStraight(dragonPos, flat)
        spawnAnimActive = false
        return
    end

    spawnAnimActive = true
    spawnAnimStart = os.clock()
    spawnAnimSpiralAngle = 0

    if SpawnAnimType == 1 or SpawnAnimType == 2 then
        spawnAnimStartPos = hrp.Position + Vector3.new(0, -40, 0)
        spawnAnimStartDir = Vector3.new(0, 1, 0)
        HeadUp = -flat
    else
        spawnAnimStartPos = hrp.Position + Vector3.new(0, 60, 0)
        spawnAnimStartDir = Vector3.new(0, -1, 0)
        HeadUp = flat
    end

    dragonPos = spawnAnimStartPos
    smoothHeadDir = spawnAnimStartDir
    HeadDir = spawnAnimStartDir
    layStraight(dragonPos, spawnAnimStartDir)
end

-- warna (logic murni, dipakai loop warna) -- dipindah keluar dari blok UI
local function pushColor(propRemote, color)
    local c = colorOf[propRemote]
    if c then pushRemote(c, color) end
end

local function colorAt(index, now)
    if ColorMode == "SOLID" then
        return Color3.fromHSV(pickH, pickS, pickV)
    elseif ColorMode == "RAINBOW" then
        return Color3.fromHSV((pickH + now * 0.12) % 1, 1, pickV)
    else
        return Color3.fromHSV((pickH + now * 0.10 + index * 0.05) % 1, 1, pickV)
    end
end

local function applyColors(now)
    if ColorMode == "OFF" then return end
    if TargetBody and not LoopColorEnabled then
        for _, r in ipairs(headDead) do pushColor(r, colorAt(0, now)) end
        for i, r in ipairs(Props) do pushColor(r, colorAt(i, now)) end
    end
    if TargetAccent then
        for _, r in ipairs(headEgg) do pushColor(r, colorAt(0, now)) end
        for _, r in ipairs(headTube) do pushColor(r, colorAt(0, now)) end
        for i, r in ipairs(moonProps) do pushColor(r, colorAt(i, now)) end
    end
end

