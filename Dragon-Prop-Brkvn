local function bindAnim(holder, fn, isActive)
    local t0 = os.clock()
    local last = t0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not holder:IsDescendantOf(game) then
            conn:Disconnect()
            return
        end
        local now = os.clock()
        local dt = math.min(now - last, 0.1)
        last = now
        if isActive and not isActive() then return end
        fn(dt, now - t0)
    end)
    track(conn)
end

-- naga ular samping: badan bergelombang, tanduk, duri, sayap (opsional), napas api
local function newDragonArt(parent, W, H, o)
    o = o or {}
    local N = o.segments or 14
    local hs = o.head or 18
    local gap = o.gap or (W*0.5/N)
    local amp = o.amp or (H*0.22)
    local headX = o.headX or (W*0.68)
    local cy = H/2
    local fireLen = o.fireLen or math.max(W - headX - 8, 30)

    local holder = Instance.new("Frame")
    holder.Name = "DragonArt"
    holder.BackgroundTransparency = 1
    holder.Size = UDim2.new(0,W,0,H)
    holder.Parent = parent

    -- sayap
    local bones, wingLines, boneLen = {}, {}, {}
    if o.wings then
        local L = H*0.42
        boneLen = {L, L*0.84, L*0.62}
        for i = 1, 3 do
            local b = part(holder, boneLen[i], 2, COL_GOLD, 1)
            b.AnchorPoint = Vector2.new(0, 0.5)
            bones[i] = b
        end
        for i = 1, 2 do
            local l = part(holder, 10, 1.5, COL_BODY_A, 1)
            l.AnchorPoint = Vector2.new(0, 0.5)
            wingLines[i] = l
        end
    end

    -- badan + duri punggung
    local segs, spikes, segSize = {}, {}, {}
    for k = 1, N do
        local s = (hs*0.8) * (1 - 0.72*(k/N)) + 3
        segSize[k] = s
        local c = COL_BODY_A:Lerp(COL_BODY_B, (k-1)/math.max(N-1,1))
        local z = (N-k)*3 + 5
        local seg = part(holder, s, s, c, z, 0.5)
        local shine = part(seg, s*0.5, s*0.5, c:Lerp(Color3.new(1,0.7,0.5), 0.35), 1, 0.5)
        shine.Position = UDim2.new(0.5,0,0.38,0)
        shine.BackgroundTransparency = 0.45
        segs[k] = seg
        if k <= N-2 then
            local sp = part(holder, s*0.55+2, s*0.55+2, COL_GOLD, z-1)
            sp.Rotation = 45
            spikes[k] = sp
        end
    end

    -- kepala
    local hz = 3*N + 10
    local head = part(holder, hs*1.8, hs*0.95, COL_BODY_A, hz, 0.4)
    local function sub(par, w, h, color, rnd, px, py, z)
        local f = part(par, w, h, color, z or 1, rnd)
        f.Position = UDim2.new(px, 0, py, 0)
        return f
    end
    local jaw = sub(head, hs*1.0, hs*0.3, Color3.fromRGB(140,22,30), 0.5, 0.3, 0.82, 1)
    jaw.AnchorPoint = Vector2.new(0, 0.5)
    local horn1 = sub(head, hs*0.9, hs*0.15, COL_GOLD, 0.5, 0.3, 0.12, 1)
    horn1.AnchorPoint = Vector2.new(0, 0.5)
    local horn2 = sub(head, hs*0.6, hs*0.12, COL_GOLD, 0.5, 0.38, 0.05, 1)
    horn2.AnchorPoint = Vector2.new(0, 0.5)
    local whisker = sub(head, hs*1.1, 1.5, COL_GOLD, 0.5, 0.82, 0.68, 1)
    whisker.AnchorPoint = Vector2.new(0, 0.5)
    sub(head, hs*0.8, hs*0.6, Color3.fromRGB(170,30,34), 0.4, 0.78, 0.55, 2)
    sub(head, 3, 3, Color3.fromRGB(30,5,8), 0.5, 0.92, 0.42, 3)
    local eye = sub(head, hs*0.34, hs*0.22, COL_FIRE1, 0.5, 0.55, 0.3, 4)
    sub(eye, 2, hs*0.18, Color3.fromRGB(20,0,0), 0.5, 0.5, 0.5, 1)

    -- api
    local flames = {}
    for j = 1, (o.flames or 8) do
        local p = part(holder, 4, 4, COL_FIRE1, hz+2, 0.5)
        p.BackgroundTransparency = 1
        flames[j] = p
    end

    local phase = 0
    local function spine(k)
        local x = headX - k*gap
        local y = cy + amp*math.sin(phase - k*0.62)*(0.3 + 0.7*math.min(k/N, 1))
        return x, y
    end

    local function update(dt, t)
        local on, atk = true, false
        if o.mood then on, atk = o.mood() end
        phase += dt * (on and 4.4 or 2.3)

        local hx, hy = spine(0)
        local nx, ny = spine(1)
        local ang = math.atan2(hy - ny, hx - nx)
        local ca, sa = math.cos(ang), math.sin(ang)
        head.Position = UDim2.new(0, hx + ca*hs*0.25, 0, hy + sa*hs*0.25)
        head.Rotation = math.deg(ang)

        for k = 1, N do
            local x, y = spine(k)
            segs[k].Position = UDim2.new(0, x, 0, y)
            local sp = spikes[k]
            if sp then
                local ax, ay = spine(k-1)
                local bx, by = spine(k+1)
                local tx, ty = ax - bx, ay - by
                local m = math.sqrt(tx*tx + ty*ty)
                if m < 0.001 then m = 1 end
                tx, ty = tx/m, ty/m
                local s = segSize[k]*0.5
                sp.Position = UDim2.new(0, x + ty*s, 0, y - tx*s)
                sp.Rotation = math.deg(math.atan2(ty, tx)) + 45
            end
        end

        -- rahang, tanduk, kumis, mata
        local mouth = 0.5 + 0.5*math.sin(t*2.4)
        jaw.Rotation = 4 + (atk and 1 or mouth*0.6)*24
        horn1.Rotation = 205 + 4*math.sin(t*3)
        horn2.Rotation = 228 + 5*math.sin(t*3.4 + 1)
        whisker.Rotation = 150 + 14*math.sin(t*3.5)
        local blink = ((t % 3.6) > 3.45) and 0.15 or 1
        eye.Size = UDim2.new(0, hs*0.34, 0, hs*0.22*blink)
        eye.BackgroundColor3 = COL_FIRE1:Lerp(COL_FIRE2, 0.5 + 0.5*math.sin(t*3))

        -- napas api
        if o.fire ~= false then
            local inten = atk and 1 or (math.clamp(math.sin(t*0.9)*1.6 + 0.4, 0, 1) * 0.85)
            local mx = hx + ca*hs*1.0 - sa*hs*0.1
            local my = hy + sa*hs*1.0 + ca*hs*0.1
            for j, p in ipairs(flames) do
                local f = (t*1.25 + j/#flames) % 1
                local dist = f*fireLen
                local wob = math.sin(t*9 + j*2.1) * f * hs*0.28
                p.Position = UDim2.new(0, mx + ca*dist - sa*wob, 0, my + sa*dist + ca*wob)
                local s = 3 + f*hs*0.7
                p.Size = UDim2.new(0, s, 0, s)
                p.BackgroundTransparency = 1 - inten*(1-f)*0.95
                if f < 0.4 then
                    p.BackgroundColor3 = COL_FIRE1:Lerp(COL_FIRE2, f/0.4)
                else
                    p.BackgroundColor3 = COL_FIRE2:Lerp(COL_FIRE3, (f-0.4)/0.6)
                end
            end
        end

        -- sayap mengepak
        if o.wings then
            local sx, sy = spine(3)
            sy = sy - segSize[3]*0.3
            local fl = math.sin(t*(on and 5.5 or 3)) * 24
            local base = {252, 224, 198}
            local tipx, tipy = {}, {}
            for i = 1, 3 do
                local r = base[i] + fl*(0.75 + i*0.2)
                bones[i].Position = UDim2.new(0, sx, 0, sy)
                bones[i].Rotation = r
                local rr = math.rad(r)
                tipx[i] = sx + math.cos(rr)*boneLen[i]
                tipy[i] = sy + math.sin(rr)*boneLen[i]
            end
            for i = 1, 2 do
                local dx, dy = tipx[i+1] - tipx[i], tipy[i+1] - tipy[i]
                local l = wingLines[i]
                l.Position = UDim2.new(0, tipx[i], 0, tipy[i])
                l.Size = UDim2.new(0, math.sqrt(dx*dx + dy*dy), 0, 1.5)
                l.Rotation = math.deg(math.atan2(dy, dx))
            end
        end
    end

    bindAnim(holder, update, o.isActive)
    return holder
end

-- wajah naga tampak depan (ikon kecil): mata menyala, kedip, tanduk bergoyang
local function newDragonFace(parent, S, mood, isActive)
    local wrap = Instance.new("Frame")
    wrap.BackgroundTransparency = 1
    wrap.AnchorPoint = Vector2.new(0.5, 0.5)
    wrap.Size = UDim2.new(0, S, 0, S)
    wrap.Parent = parent

    local holder = Instance.new("Frame")
    holder.BackgroundTransparency = 1
    holder.AnchorPoint = Vector2.new(0.5, 0.5)
    holder.Position = UDim2.new(0.5, 0, 0.5, 0)
    holder.Size = UDim2.new(1, 0, 1, 0)
    holder.Parent = wrap

    local function P(w, h, color, rnd, px, py, z)
        local f = part(holder, w*S, h*S, color, z or 1, rnd)
        f.Position = UDim2.new(px, 0, py, 0)
        return f
    end
    local hornL = P(0.34, 0.085, COL_GOLD, 0.5, 0.2, 0.2, 1)
    local hornR = P(0.34, 0.085, COL_GOLD, 0.5, 0.8, 0.2, 1)
    local skull = P(0.62, 0.56, COL_BODY_A, 0.38, 0.5, 0.55, 2)
    P(0.36, 0.28, Color3.fromRGB(150,26,32), 0.4, 0.5, 0.76, 3)
    P(0.05, 0.05, Color3.fromRGB(30,5,8), 0.5, 0.43, 0.76, 4)
    P(0.05, 0.05, Color3.fromRGB(30,5,8), 0.5, 0.57, 0.76, 4)
    local fangL = P(0.045, 0.1, Color3.fromRGB(245,240,230), 0.2, 0.43, 0.92, 2)
    local fangR = P(0.045, 0.1, Color3.fromRGB(245,240,230), 0.2, 0.57, 0.92, 2)
    local eyeL = P(0.19, 0.075, COL_FIRE1, 0.5, 0.37, 0.5, 4)
    local eyeR = P(0.19, 0.075, COL_FIRE1, 0.5, 0.63, 0.5, 4)
    eyeL.Rotation = 22
    eyeR.Rotation = -22

    bindAnim(wrap, function(dt, t)
        local on = mood and mood() or false
        local glow = 0.5 + 0.5*math.sin(t*(on and 6 or 3))
        local c = COL_FIRE1:Lerp(COL_FIRE2, glow)
        eyeL.BackgroundColor3 = c
        eyeR.BackgroundColor3 = c
        local blink = (((t + 0.7) % 4) > 3.88) and 0.2 or 1
        eyeL.Size = UDim2.new(0, 0.19*S, 0, 0.075*S*blink)
        eyeR.Size = UDim2.new(0, 0.19*S, 0, 0.075*S*blink)
        hornL.Rotation = 52 + 4*math.sin(t*2)
        hornR.Rotation = -52 - 4*math.sin(t*2)
        skull.BackgroundColor3 = COL_BODY_A:Lerp(Color3.fromRGB(255,90,60), on and 0.35 or 0)
        holder.Position = UDim2.new(0.5, 0, 0.5, math.sin(t*2.2)*1.2)
    end, isActive)
    return wrap
end

