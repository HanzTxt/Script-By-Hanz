local function beginSpawnAnimation()
    if not hrp then return end
    updateProps()
    lastUpdate = os.clock()
    local look = hrp.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.001 then flat = Vector3.new(0,0,1) end
    flat = flat.Unit
    spawnAnimEndPos = hrp.Position + Vector3.new(0,8,0)
    spawnAnimEndDir = flat
    if not SpawnAnimEnabled then
        dragonPos = spawnAnimEndPos
        smoothHeadDir = flat
        HeadDir = flat
        HeadUp = WORLD_UP
        layStraight(dragonPos, flat)
        spawnAnimActive = false
        return
    end
    spawnAnimActive = true
    spawnAnimStart = os.clock()
    spawnAnimSpiralAngle = 0
    if SpawnAnimType == 1 or SpawnAnimType == 2 then
        spawnAnimStartPos = hrp.Position + Vector3.new(0,-40,0)
        spawnAnimStartDir = Vector3.new(0,1,0)
        HeadUp = -flat
    else
        spawnAnimStartPos = hrp.Position + Vector3.new(0,60,0)
        spawnAnimStartDir = Vector3.new(0,-1,0)
        HeadUp = flat
    end
    dragonPos = spawnAnimStartPos
    smoothHeadDir = spawnAnimStartDir
    HeadDir = spawnAnimStartDir
    layStraight(dragonPos, spawnAnimStartDir)
end

