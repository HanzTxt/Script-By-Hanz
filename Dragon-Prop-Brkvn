local function pad(g, p)
    local u = Instance.new("UIPadding")
    u.PaddingTop = UDim.new(0,p); u.PaddingBottom = UDim.new(0,p)
    u.PaddingLeft = UDim.new(0,p); u.PaddingRight = UDim.new(0,p)
    u.Parent = g; return u
end
-- frame kecil berpusat (dipakai untuk menggambar naga dari bentuk UI)
local function part(parent, w, h, color, z, rnd)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5,0.5)
    f.Size = UDim2.new(0,w,0,h)
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    f.ZIndex = z or 1
    if rnd then
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(rnd,0); c.Parent = f
    end
    f.Parent = parent
    return f
end

