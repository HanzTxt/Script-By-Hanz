            Size = UDim2.new(1, -80, 1, 0),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
            Text = labelText, TextSize = 13,
            TextColor3 = defaultOn and Theme.Text or Theme.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
        })

        local switchTrack = make("Frame", {
            Size = UDim2.fromOffset(40, 20),
            Position = UDim2.new(1, -54, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = defaultOn and Theme.Accent or Theme.BG3,
            BorderSizePixel = 0, Parent = row,
        })
        corner(switchTrack, 999)
        addStroke(switchTrack, Theme.Stroke, 1, 0)

        local thumb = make("Frame", {
            Size = UDim2.fromOffset(14, 14),
            Position = defaultOn and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = defaultOn and Theme.Gold or Theme.Text,
            BorderSizePixel = 0, Parent = switchTrack,
        })
        corner(thumb, 999)

        local btn = make("TextButton", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = "", Parent = row,
        })

        local state = defaultOn
        local function applyVisual(s)
            tween(switchTrack, {BackgroundColor3 = s and Theme.Accent or Theme.BG3}, 0.2)
            tween(thumb, {
                Position = s and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = s and Theme.Gold or Theme.Text,
            }, 0.22)
            tween(label, {TextColor3 = s and Theme.Text or Theme.TextDim}, 0.2)
        end

        btn.MouseButton1Click:Connect(function()
            state = not state
            applyVisual(state)
            if onChange then onChange(state) end
        end)
        return row
    end

    local function makeInputRow(parent, labelText, defaultValue, onChanged, order)
        local row = make("Frame", {
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundColor3 = Theme.BG2, BorderSizePixel = 0,
            LayoutOrder = order, Parent = parent,
        })
        corner(row, 8)
